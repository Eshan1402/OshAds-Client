# Copy to .env.local (never commit it). The server and Vite both read it.
PORT=8788
# Where the Vite dev server sends /api (default http://127.0.0.1:8788).
# API_TARGET=http://127.0.0.1:8788
# Staff accounts (src/data/users.ts) are created with this password on an empty database.
SEED_PASSWORD=choose-a-long-password
# Secret advertisers put in the install postback URL (/api/postback?...&key=). 16+ characters.
POSTBACK_KEY=
# Optional machine access to /api/stats (Authorization: Bearer …), 16+ characters.
STATS_TOKEN=
# DB_PATH=server/.data/oshads.db
# TRUST_PROXY=1   # only behind a reverse proxy that sets X-Forwarded-For; also enables country from CF-IPCountry etc.
# SITE_URL=https://oshads.com
# Staff sign-in with Google (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <SITE_URL>/api/auth/google/callback. When both are set, password login is switched off.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STAFF_DOMAIN=oshads.com
