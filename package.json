{
  "name": "adwin-media",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=8788 npm run server & vite",
    "build": "tsc -b && npm run sitemap && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "audit": "node scripts/audit.mjs",
    "mcp": "tsx --tsconfig growth/tsconfig.json growth/mcp/server.ts",
    "mcp:http": "tsx --tsconfig growth/tsconfig.json growth/mcp/server.ts --http",
    "social:agent": "tsx --tsconfig growth/tsconfig.json growth/agent/social-agent.ts",
    "social:review": "tsx --tsconfig growth/tsconfig.json growth/agent/review.ts",
    "social:publish": "tsx --tsconfig growth/tsconfig.json growth/agent/review.ts publish",
    "typecheck:growth": "tsc -p growth/tsconfig.json --noEmit",
    "sitemap": "tsx --tsconfig growth/tsconfig.json scripts/sitemap.ts",
    "test": "tsx --tsconfig server/tsconfig.json --test src/lib/*.test.ts server/*.test.ts",
    "server": "tsx --env-file-if-exists=.env.local --tsconfig server/tsconfig.json server/index.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env.local --env-file-if-exists=.env --tsconfig server/tsconfig.json server/index.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
